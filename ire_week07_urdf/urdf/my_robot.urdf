<?xml version="1.0"?>
<!-- 7주차 예제 — 몸통 + 목(revolute) + 머리. 슬라이더로 목을 돌려보세요. -->
<robot name="my_robot">
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
  </link>
  <link name="neck">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.02" length="0.2"/></geometry>
      <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
  </link>
  <link name="head">
    <visual>
      <geometry><sphere radius="0.06"/></geometry>
      <material name="teal"><color rgba="0.0 0.6 0.63 1"/></material>
    </visual>
  </link>
  <joint name="base_neck_joint" type="revolute">
    <parent link="base_link"/>
    <child link="neck"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>
  <joint name="neck_head_joint" type="fixed">
    <parent link="neck"/>
    <child link="head"/>
    <origin xyz="0 0 0.23"/>
  </joint>
</robot>
