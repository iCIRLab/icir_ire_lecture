<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ire_assets</name>
  <version>0.1.0</version>
  <description>IRE 공용 Gazebo 모델·월드·RViz 설정</description>
  <maintainer email="js.park@cnu.ac.kr">Jinseong Park</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <export>
    <build_type>ament_python</build_type>
    <!-- Gazebo가 model:// URI를 찾을 수 있도록 모델 경로를 등록한다.
         이 export가 없으면 aruco_box의 머티리얼(model://aruco_box/materials/...)을
         해석하지 못해 텍스처 없는 회색 상자로 렌더링된다. -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
